{
  "name": "gyrelab",
  "private": true,
  "type": "module",
  "description": "Gyrelab: a workbench for twisty puzzles, built on cubing.js, with twsearch doing the searching.",
  "license": "MPL-2.0 OR GPL-3.0-or-later",
  "scripts": {
    "dev": "bun script/build.mjs --serve",
    "build": "bun script/build.mjs",
    "site": "bun script/build.mjs --site site",
    "check": "tsc --noEmit",
    "build-twsearch": "bun script/build-twsearch.mjs",
    "update-twsearch": "bun script/update-twsearch.mjs"
  },
  "dependencies": {
    "@fontsource/ubuntu": "5.3.0",
    "cubing": "0.63.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2"
  }
}
